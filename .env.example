# Copy to .env.local and fill in. .env.local is git-ignored; never commit a real key.
OPENROUTER_API_KEY=
# The run limits, the cache and the follow-up tickets live in a Redis store. On
# Vercel these four are filled in when the store is attached to the project
# ("vercel env pull" brings them down). Without them, local development uses
# memory, and a production build refuses to run live checks.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional. Keys the hash that stands in for a visitor's address. If it is empty
# the model key is used for this, which is already secret.
LIMIT_SALT=
